generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES
  TECHNICIAN
  INSTALLER
}
enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  VISIT
  QUOTE
  NEGOTIATION
  WON
  LOST
}
enum TaskStatus {
  PENDING
  DONE
  CANCELLED
}
enum ProjectStatus {
  PLANNED
  MATERIALS
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  role Role @default(SALES)
  phone String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  leads Lead[]
  tasks Task[]
  projects Project[]
  trips Travel[]
  expenses Expense[]
}

model Customer {
  id String @id @default(cuid())
  name String
  company String?
  phone String?
  whatsapp String?
  email String?
  address String?
  city String?
  province String?
  lat Float?
  lng Float?
  customerType String?
  monthlyKwh Float?
  connection String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads Lead[]
  visits TechnicalVisit[]
  projects Project[]
  tasks Task[]
  tickets ServiceTicket[]
  trips Travel[]
  quotes Quote[]
}

model Lead {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title String
  stage LeadStage @default(NEW)
  estimatedKw Float?
  amount Float?
  source String?
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id])
  nextFollow DateTime?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quotes Quote[]
}

model Task {
  id String @id @default(cuid())
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id])
  title String
  dueAt DateTime
  priority String @default("MEDIUM")
  status TaskStatus @default(PENDING)
  notes String?
  createdAt DateTime @default(now())
}

model TechnicalVisit {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  scheduledAt DateTime?
  roofType String?
  shading String?
  phase String?
  panelArea Float?
  inverterLocation String?
  notes String?
  createdAt DateTime @default(now())
}

model Quote {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  number String @unique
  subtotal Float
  installation Float @default(0)
  travel Float @default(0)
  discount Float @default(0)
  total Float
  status String @default("SENT")
  validUntil DateTime?
  notes String?
  createdAt DateTime @default(now())
  items QuoteItem[]
}

model QuoteItem {
  id String @id @default(cuid())
  quoteId String
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name String
  quantity Float
  unitPrice Float
}

model Project {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id])
  name String
  status ProjectStatus @default(PLANNED)
  scheduledAt DateTime?
  installedKw Float?
  address String?
  notes String?
  warrantyUntil DateTime?
  createdAt DateTime @default(now())
  materials ProjectMaterial[]
  tickets ServiceTicket[]
  trips Travel[]
  expenses Expense[]
}

model Product {
  id String @id @default(cuid())
  name String
  category String
  sku String? @unique
  stock Float @default(0)
  reserved Float @default(0)
  minStock Float @default(0)
  unit String @default("unidad")
  unitCost Float?
  createdAt DateTime @default(now())
  materials ProjectMaterial[]
}

model ProjectMaterial {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Float
}

model ServiceTicket {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title String
  description String?
  status TicketStatus @default(OPEN)
  priority TicketPriority @default(MEDIUM)
  scheduledAt DateTime?
  closedAt DateTime?
  createdAt DateTime @default(now())
}

model Travel {
  id String @id @default(cuid())
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id])
  origin String
  destination String
  departureAt DateTime
  returnAt DateTime?
  km Float?
  vehicle String?
  status String @default("PLANNED")
  notes String?
  createdAt DateTime @default(now())
}

model Expense {
  id String @id @default(cuid())
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id])
  projectId String?
  project Project? @relation(fields: [projectId], references: [id])
  category String
  description String
  amount Float
  expenseAt DateTime @default(now())
  status String @default("PENDING")
}
