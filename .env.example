# Produccion (Supabase)
# DATABASE_URL: Transaction pooler (puerto 6543) para la app en Vercel.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: conexion directa/session para migraciones Prisma (puerto 5432).
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# Identificador usado por Nominatim para geocodificacion.
GEOCODING_USER_AGENT="SolarCRM/1.0 (admin@tuempresa.com)"
